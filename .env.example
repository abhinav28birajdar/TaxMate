# ==============================================================================
# TaxMate Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# Never commit .env.local or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (PostgreSQL Database, Auth, Storage & Realtime)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# [PUBLIC] Base URL of your Supabase project (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# [PUBLIC] Anonymous public API key (safe for browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# [SERVER-ONLY - SECRET] Super-admin service role key. NEVER expose to frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional dedicated analytics database
NEXT_PUBLIC_ANALYTICS_SUPABASE_URL=
NEXT_PUBLIC_ANALYTICS_SUPABASE_ANON_KEY=
ANALYTICS_SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical URL of the frontend (used for redirects, emails, links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Emergency maintenance mode switch ('true' | 'false')
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE="We are performing scheduled maintenance. We will be back shortly."

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# [SERVER-ONLY - SECRET] Min 32-character key for signing internal session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_a_random_value_at_least_32_characters_long
BCRYPT_SALT_ROUNDS=12

# Supabase Auth redirect destination
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY
# Get these from: Razorpay Dashboard -> Account & Settings -> API Keys & Webhooks
# ------------------------------------------------------------------------------
# [PUBLIC] Test key: rzp_test_... | Live key: rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# [SERVER-ONLY - SECRET] API Key Secret for order creation & signature verification
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# [SERVER-ONLY - SECRET] Secret used to verify incoming webhook payloads
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Subscription Plan IDs
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_ENTERPRISE=

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# Get these from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
# [SERVER-ONLY - SECRET] Resend API key (re_...)
RESEND_API_KEY=re_...

# Verified sender address or domain
RESEND_FROM_EMAIL="TaxMate <noreply@yourdomain.com>"

# Inbound contact/sales inquiry forwarding destination
SUPPORT_INBOX_EMAIL=support@yourdomain.com

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED CACHE & RATE LIMITING (Upstash Redis)
# Get these from: https://console.upstash.com/redis
# If omitted, application falls back to robust local in-memory sliding window
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ------------------------------------------------------------------------------
# 7. AI & DOCUMENT OCR (Server-Only)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_VISION_API_KEY=

# ------------------------------------------------------------------------------
# 8. MONITORING & ANALYTICS (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
